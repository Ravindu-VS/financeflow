{
  "name": "wealth-intelligence-platform",
  "version": "1.0.0",
  "description": "Smart Personal Finance & Wealth Intelligence Platform",
  "private": true,
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "test": "npm --workspace client run test",
    "test:e2e": "npm --workspace client run test:e2e",
    "typecheck": "npm --workspace client run typecheck",
    "ai:dev": "cd ai-backend && uvicorn main:app --reload --port 8000",
    "gateway:dev": "cd gateway && npm start"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
